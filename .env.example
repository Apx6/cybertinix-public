# Copier en .env et compléter. Ne jamais committer .env.

# --- Domaine -----------------------------------------------------------------
# Apparaît à l'écran du véhicule lors de l'appairage de la clé virtuelle, et
# doit correspondre au root domain des allowed_origins déclarés sur le portail
# développeur. Difficile à changer une fois l'application enregistrée.
DOMAIN=
LETSENCRYPT_EMAIL=

# Jeton exigé sur toutes les routes sauf /healthz et le callback OAuth.
# Générer avec : openssl rand -hex 32
# Vide, l'application refuse de servir les routes protégées.
API_TOKEN=

# --- Application Tesla -------------------------------------------------------
# Fournis par developer.tesla.com après validation de la demande.
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=

# Région EMEA. Le token est lié à cette audience : la changer impose de
# refaire l'enregistrement partenaire.
TESLA_AUDIENCE=https://fleet-api.prd.eu.vn.cloud.tesla.com

# vehicle_location est un scope distinct : sans lui, aucune donnée GPS.
TESLA_SCOPES=openid offline_access user_data vehicle_device_data vehicle_location vehicle_cmds vehicle_charging_cmds

# --- Notifications -----------------------------------------------------------
# Bot créé via @BotFather sur Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Infra -------------------------------------------------------------------
POSTGRES_PASSWORD=
